{
  "name": "@gamehub/eleven",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "일레븐: 축구 구단 매니지먼트 보드게임(한 기기, 봇, 온라인)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && gamehub-build-server",
    "start": "gamehub-serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/mobile.mjs",
    "balance": "esbuild src/bot/balance.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/balance.mjs && node node_modules/.cache/balance.mjs"
  },
  "dependencies": {
    "@gamehub/config": "*",
    "@gamehub/net": "*",
    "@gamehub/ui": "*"
  }
}
