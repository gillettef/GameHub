{
  "permissions": {
    "allow": [
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(npx tsc:*)",
      "Bash(npx vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin dev)",
      "Bash(git push -u origin dev)",
      "Bash(git pull --rebase origin dev)",
      "Bash(git remote:*)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev.ps1)",
      "Bash(powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-stop.ps1)",
      "Bash(tail:*)",
      "Bash(cat .dev/*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push -u origin main:*)"
    ]
  }
}
