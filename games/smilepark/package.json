{
  "name": "@gamehub/smilepark",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "스마일 파크: 놀이공원을 경영해 만족도를 겨루는 2~5인 보드게임(한 기기 AI 대전·돌려 하기, 온라인, 관전)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && gamehub-build-server",
    "start": "gamehub-serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/mobile.mjs",
    "sim": "npx --yes tsx scripts/simulate.ts",
    "balance": "npx --yes tsx scripts/balance.ts"
  },
  "dependencies": {
    "@gamehub/config": "*",
    "@gamehub/net": "*",
    "@gamehub/ui": "*"
  }
}
