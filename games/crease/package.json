{
  "name": "@gamehub/crease",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CREASE 규칙 엔진·봇·밸런스 시뮬레이터와 웹 게임(한 기기, 온라인, 봇 관전)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && gamehub-build-server",
    "start": "gamehub-serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/mobile.mjs",
    "sim": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/sim.ts",
    "figure": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/make-figure.ts"
  },
  "dependencies": {
    "@gamehub/config": "*",
    "@gamehub/net": "*",
    "@gamehub/ui": "*"
  }
}
