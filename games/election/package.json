{
  "name": "@gamehub/election",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "유세 대작전: 유세 버스로 여섯 권역을 도는 만칼라형 2인 보드게임(봇, 한 기기, 온라인, 관전)",
  "scripts": {
