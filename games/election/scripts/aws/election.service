[Unit]
Description=유세 대작전 온라인 대결 서버 (포트 8096)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__APP__
Environment=PORT=8096
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node __APP__/server-dist/server.cjs
Restart=always
RestartSec=3
MemoryMax=180M

[Install]
WantedBy=multi-user.target
