{
  "name": "@gamehub/retrocause",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "RETROCAUSE 규칙 엔진·봇·시뮬레이터와 웹 게임(봇 대전·한 기기 돌려 하기, 온라인 대전, 관전)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && gamehub-build-server",
    "start": "gamehub-serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/mobile.mjs",
    "sim": "node --experimental-strip-types --no-warnings=ExperimentalWarning tools/sim.ts"
  },
  "dependencies": {
    "@gamehub/config": "*",
    "@gamehub/net": "*",
    "@gamehub/ui": "*"
  }
}
