{
  "name": "@gamehub/neoterra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "네오테라: 새 행성 개척 문명 카드게임(한 기기 AI 대전, 온라인)",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && gamehub-build-server",
    "start": "gamehub-serve",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "node e2e/mobile.mjs",
    "simulate": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --outfile=server-dist/simulate.mjs --log-level=warning && node server-dist/simulate.mjs"
  },
  "dependencies": {
    "@gamehub/config": "*",
    "@gamehub/net": "*",
    "@gamehub/ui": "*",
    "zustand": "4.5.5"
  }
}
