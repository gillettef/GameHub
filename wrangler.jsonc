// Cloudflare Workers 설정 — 정적 사이트(dist/)와 온라인 대결 API(/api/*)를 한 Worker로 배포한다.
// 배포: npm run deploy   로컬 서버: npm run dev:server (포트 38637, Vite가 /api를 여기로 프록시)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "election-mancala",
  "main": "server/worker.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // /api/* 만 Worker 코드가 처리하고 나머지는 정적 파일로 바로 응답
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "dev": {
    "ip": "0.0.0.0",
    "port": 38637
  }
}
