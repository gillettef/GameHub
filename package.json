{
  "name": "gamehub",
  "private": true,
  "type": "module",
  "description": "GameHub 공통 패키지(packages/*)와 새 기술스택으로 옮긴 게임의 npm workspaces 루트. 아직 옮기지 않은 게임은 각자 폴더에서 따로 설치한다.",
  "workspaces": [
    "packages/*",
    "games/crease",
    "games/doubleagent",
    "games/election",
    "games/hearsay",
    "games/lastgrain",
    "games/lightcone",
    "games/neoterra",
    "games/proxymind",
    "games/retrocause",
    "games/sightline",
    "games/tesseract"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint packages games/crease games/doubleagent games/election games/hearsay games/lastgrain games/lightcone games/neoterra games/proxymind games/retrocause games/sightline games/tesseract",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "e2e": "npm run e2e --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.7",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
