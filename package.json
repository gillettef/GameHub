{
  "name": "rootbound",
  "private": true,
  "version": "0.1.0",
  "description": "식물을 심어 뿌리로 땅을 넓히는 웹 정원 땅따먹기 보드게임 (2~4인, 드래프트)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p shared && tsc --noEmit -p server && tsc --noEmit -p client",
    "fixtures": "tsx shared/scripts/write-fixtures.ts",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
