{
  "name": "proxymind",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PROXYMIND 웹 시뮬레이터 — 봇 대전, 온라인 대전, 자동 시뮬레이션",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch prototype/server/index.ts",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild prototype/server/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=server-dist/server.cjs --external:bufferutil --external:utf-8-validate --log-level=warning",
    "preview": "vite preview",
    "start": "node scripts/aws/serve.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "ws": "^8.23.0"
  }
}
